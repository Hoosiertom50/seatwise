{
  "name": "seatwise",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @seatwise/web dev",
    "build": "pnpm --filter @seatwise/web build",
    "db:generate": "pnpm --filter @seatwise/db generate",
    "db:migrate": "pnpm --filter @seatwise/db migrate",
    "pw:install": "playwright install chromium",
    "pw:list": "playwright test --project=chromium --project=framework-unit --list",
    "pw:test": "playwright test --project=chromium --project=framework-unit",
    "pw:test:headed": "playwright test --project=chromium --headed",
    "pw:test:debug": "playwright test --project=chromium --debug",
    "pw:test:ui": "playwright test --ui",
    "pw:report": "playwright show-report artifacts/playwright/runs/html-report",
    "pw:serve-report": "playwright show-report artifacts/playwright/runs/html-report --host 0.0.0.0",
    "pw:validate-metadata": "tsx playwright-framework/cli/validate-metadata.ts",
    "pw:generate-value-model-md": "tsx playwright-framework/cli/generate-value-model-md.ts",
    "pw:lint-tests": "tsx playwright-framework/cli/lint-tests.ts",
    "pw:validate": "tsc --noEmit && pnpm pw:validate-metadata && pnpm pw:lint-tests && playwright test --project=chromium --project=framework-unit --list",
    "pw:run": "tsx playwright-framework/cli/run-tests.ts",
    "pw:run:readonly": "tsx playwright-framework/cli/run-tests.ts --selection readonly",
    "pw:run:smoke": "tsx playwright-framework/cli/run-tests.ts --selection smoke",
    "pw:run:regression": "tsx playwright-framework/cli/run-tests.ts --selection regression",
    "pw:run:critical": "tsx playwright-framework/cli/run-tests.ts --selection critical",
    "pw:report:run": "tsx playwright-framework/cli/serve-run-report.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  }
}
