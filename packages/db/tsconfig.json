{
  "//": "TS-176: lets CI typecheck this package and its maintenance scripts (tsc --noEmit).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "prisma/*.ts"]
}
