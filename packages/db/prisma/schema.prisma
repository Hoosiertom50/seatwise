// Seatwise data model
// Modeled from the Seatwise Requirements & Acceptance Criteria docs (FR-0.x through FR-10.x).
// This first pass wires up the tables needed for auth + wedding/guest management (the current
// vertical slice) and lays down the full relational shape (tables, seating rules, plan
// versioning, change history) that later stories (TS-6 through TS-15 in Jira) will build on,
// so those features are additive rather than requiring a schema rework.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Accounts -----------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weddings Wedding[]
  // TS-13 (Collaboration & Notifications): access another owner's wedding grants, comments this
  // user has authored, and in-app notifications addressed to this user.
  collaboratingOn WeddingCollaborator[]
  comments        Comment[]
  notifications   Notification[]

  @@map("users")
}

// --- Core wedding / guest domain (FR-1, FR-2) ---------------------------

enum WeddingStatus {
  PLANNING
  APPROVED
  ARCHIVED
}

// FR-3.4: one wedding-level setting weighting how much generation mixes the two sides at a
// table. Always a soft preference (FR-3.4 is explicit it's never a hard rule) — see
// seating-engine.ts's side-mixing scoring.
enum SideMixingSetting {
  KEEP_SEPARATE
  BALANCED_MIX
  FULLY_MIXED
}

model Wedding {
  id        String        @id @default(cuid())
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  eventDate DateTime?     @db.Date
  venueName String?
  status    WeddingStatus @default(PLANNING)
  // FR-10.2: email delivery is opt-out per wedding — this flips it off entirely for this
  // wedding's notifications; the in-app notification itself always still fires.
  emailNotificationsEnabled Boolean @default(true)
  // FR-3.4
  sideMixing SideMixingSetting @default(BALANCED_MIX)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  guests        Guest[]
  relationships GuestRelationship[]
  tables        SeatingTable[]
  planVersions  PlanVersion[]
  ruleConfigs   RuleWeightConfig[]
  collaborators WeddingCollaborator[]
  comments      Comment[]
  notifications Notification[]

  @@index([ownerId])
  @@map("weddings")
}

// --- Collaboration & notifications (FR-10.x) ------------------------------

// "View/Comment/Edit" from the requirements doc, in increasing order of what's allowed. The
// owner is implicitly above Edit (can manage collaborators, rename/delete the wedding) and isn't
// itself a row in this table.
enum CollaboratorPermission {
  VIEW
  COMMENT
  EDIT
}

model WeddingCollaborator {
  id              String                 @id @default(cuid())
  weddingId       String
  wedding         Wedding                @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionLevel CollaboratorPermission @default(VIEW)
  invitedByUserId String?
  createdAt       DateTime               @default(now())

  @@unique([weddingId, userId])
  @@index([userId])
  @@map("wedding_collaborators")
}

enum CommentTargetType {
  GUEST
  TABLE
}

model Comment {
  id               String            @id @default(cuid())
  weddingId        String
  wedding          Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  targetType       CommentTargetType
  guestId          String?
  guest            Guest?            @relation(fields: [guestId], references: [id], onDelete: SetNull)
  tableId          String?
  table            SeatingTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  // FR-10.3: captured once at creation so the comment stays understandable even after its guest
  // or table is renamed or removed — "stays attached to that historical target rather than being
  // silently reassigned". If guestId/tableId is null but targetType still says GUEST/TABLE, the
  // original target was removed; targetLabel is what's shown in its place.
  targetLabel      String
  body             String
  authorUserId     String
  author           User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parentCommentId  String?
  parentComment    Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies          Comment[]         @relation("CommentReplies")
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime          @default(now())

  @@index([weddingId])
  @@index([guestId])
  @@index([tableId])
  @@map("comments")
}

enum NotificationType {
  PLAN_SHARED
  COMMENT_REPLY
  TABLE_CHANGED
  GUEST_ADDED
  GUEST_REMOVED
  ATTENDANCE_CHANGED
  STATUS_CHANGED
}

model Notification {
  id              String           @id @default(cuid())
  weddingId       String
  wedding         Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  message         String
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([recipientUserId])
  @@index([weddingId])
  @@map("notifications")
}

enum GuestTier {
  VIP
  FAMILY
  FRIEND
  PLUS_ONE
  OTHER
}

// FR-3.4: which side of the wedding a guest belongs to, for Side-Mixing weighting. BOTH (the
// default) is the "invited by/close to both" case and never counts toward either side.
enum GuestSide {
  BRIDE
  GROOM
  BOTH
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

// FR-8.1 (Day-Of Mode): distinct from rsvpStatus — a guest can RSVP Confirmed weeks ahead and
// still no-show, or walk in unannounced. Attendance is the day-of, same-day-editable signal.
enum DayOfAttendance {
  ATTENDING
  NOT_ATTENDING
}

model Guest {
  id                      String     @id @default(cuid())
  weddingId               String
  wedding                 Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  firstName               String
  lastName                String
  partyName               String?
  headcount               Int        @default(1)
  tier                    GuestTier  @default(OTHER)
  rsvpStatus              RsvpStatus @default(PENDING)
  requiresAccessibleTable Boolean    @default(false)
  // FR-3.4
  side                    GuestSide  @default(BOTH)
  // FR-7.4: when locked, automated (re)generation keeps this guest at their current table
  // instead of reshuffling them; manual moves and hard-rule checks are never affected by a lock.
  isLocked                Boolean    @default(false)
  dayOfAttendance         DayOfAttendance @default(ATTENDING)
  notes                   String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  relationshipsFrom GuestRelationship[] @relation("relationshipGuestA")
  relationshipsTo   GuestRelationship[] @relation("relationshipGuestB")
  seatAssignments   SeatAssignment[]
  comments          Comment[]
  // FR-3.7a: at most one restricted table can require this guest, wedding-wide (enforced by the
  // @@unique([guestId]) below, not just app logic).
  requiredAtTable   RestrictedTableGuest?

  @@index([weddingId])
  @@map("guests")
}

// --- Relationships & seating rules (FR-3) --------------------------------

enum RelationshipType {
  MUST_SIT_TOGETHER
  MUST_NOT_SIT_TOGETHER
  PREFER_NEAR
  AVOID
}

model GuestRelationship {
  id        String           @id @default(cuid())
  weddingId String
  wedding   Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestAId  String
  guestA    Guest            @relation("relationshipGuestA", fields: [guestAId], references: [id], onDelete: Cascade)
  guestBId  String
  guestB    Guest            @relation("relationshipGuestB", fields: [guestBId], references: [id], onDelete: Cascade)
  type      RelationshipType
  createdAt DateTime         @default(now())

  @@unique([weddingId, guestAId, guestBId, type])
  @@index([weddingId])
  @@map("guest_relationships")
}

// --- Table & venue layout (FR-4) ------------------------------------------

model SeatingTable {
  id           String   @id @default(cuid())
  weddingId    String
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  label        String
  capacity     Int
  isRestricted Boolean  @default(false)
  isAccessible Boolean  @default(false)
  // FR-7.4: when locked, automated (re)generation won't assign new guests here — reserved for
  // whoever's already seated here (or a locked guest pinned here). Manual moves can still target
  // a locked table, and hard-rule checks are never affected by a lock.
  isLocked     Boolean  @default(false)
  purpose      String?
  // FR-3.4: a table-level override — favor seating only one side here, regardless of the
  // wedding's overall Side-Mixing setting. Still only ever a soft preference (see engine).
  singleSideOnly Boolean @default(false)
  positionX    Float?
  positionY    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seatAssignments SeatAssignment[]
  comments        Comment[]
  // FR-3.7a: this table's explicit required-guest list, when isRestricted is true.
  requiredGuests  RestrictedTableGuest[]

  @@index([weddingId])
  @@map("seating_tables")
}

// FR-3.7a: a Restricted table's explicit required guest list — a hard rule, not a preference.
// Every listed Attending guest must be seated at exactly this table; a guest may be required at
// only one Restricted table wedding-wide (the @@unique([guestId]) below enforces that at the
// database level, not just in application code); manual moves can't violate either side of the
// list (see moveGuestAssignment in plan-versions.ts).
model RestrictedTableGuest {
  id        String       @id @default(cuid())
  tableId   String
  table     SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([tableId, guestId])
  @@unique([guestId])
  @@map("restricted_table_guests")
}

// --- Plan versions & change history (FR-9.4) ------------------------------

// Review/approval workflow status (FR-6.4). Applies only to the Current Plan Version — the one
// with the highest versionNumber for a wedding; older versions keep whatever status they had
// when superseded, since FR-6.4 only lets the Current version's status change going forward.
enum PlanVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

model PlanVersion {
  id             String            @id @default(cuid())
  weddingId      String
  wedding        Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  versionNumber  Int
  label          String?
  status         PlanVersionStatus @default(DRAFT)
  isComplete     Boolean           @default(false)
  // Set when status moves to APPROVED, cleared (not deleted) when it moves away again. FR-6.6's
  // "Modified Since Approval" indicator is derived from this: active whenever status is
  // APPROVED and a change_history_entries row exists with createdAt after approvedAt.
  approvedAt     DateTime?
  restoredFromId String?
  restoredFrom   PlanVersion?      @relation("restoredFrom", fields: [restoredFromId], references: [id])
  restoredInto   PlanVersion[]     @relation("restoredFrom")
  // FR-3.4 AC: "each Plan Version records the setting and weighting-configuration version used" —
  // null on a version restored/created before this field existed.
  sideMixingSetting SideMixingSetting?
  ruleConfigVersion Int?
  createdAt      DateTime          @default(now())

  seatAssignments SeatAssignment[]
  changeHistory   ChangeHistoryEntry[]

  @@unique([weddingId, versionNumber])
  @@index([weddingId])
  @@map("plan_versions")
}

model SeatAssignment {
  id                 String       @id @default(cuid())
  planVersionId       String
  planVersion         PlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  guestId             String
  guest               Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  seatingTableId      String
  seatingTable        SeatingTable @relation(fields: [seatingTableId], references: [id], onDelete: Cascade)
  needsReassignment   Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([planVersionId, guestId])
  @@index([planVersionId])
  @@map("seat_assignments")
}

model ChangeHistoryEntry {
  id            String      @id @default(cuid())
  planVersionId String
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  action        String
  description   String
  actorUserId   String?
  createdAt     DateTime    @default(now())

  @@index([planVersionId])
  @@map("change_history_entries")
}

// --- Soft-rule weighting config (FR-0.2) ----------------------------------

model RuleWeightConfig {
  id        String   @id @default(cuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  version   Int
  config    Json
  createdAt DateTime @default(now())

  @@unique([weddingId, version])
  @@map("rule_weight_configs")
}
