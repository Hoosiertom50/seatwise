{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts", "playwright-framework/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages", "artifacts"]
}
