DATABASE_URL="postgresql://user:password@localhost:5432/seatwise_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
# NFR-9.3b: key used to encrypt guest notes (dietary/accessibility details) at rest.
ENCRYPTION_KEY="replace-with-a-long-random-secret"
# TS-132: email (invites, RSVP links, notifications) -- see packages/db/src/email.ts.
# Production sends through a Gmail account with an app password: set SMTP_USER and SMTP_PASSWORD
# (as Netlify *secret* variables -- never commit the password). Host/port default to Gmail's.
# Leave them unset locally: outside production emails are printed to the server log instead.
SMTP_USER=""
SMTP_PASSWORD=""
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# EMAIL_FROM="Seatwise <seatwise.notifications@gmail.com>"
# Print instead of sending even in production (CI sets this).
# EMAIL_TRANSPORT="log"
# Alternative for later, once Seatwise has its own domain: Resend (https://resend.com).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Seatwise <notifications@yourdomain.com>"

# FR-1.4a: the base URL used to build an invite's accept link (.../invites/:token) in the
# invite email. Defaults to the local dev URL below when unset.
APP_URL="http://localhost:3000"
